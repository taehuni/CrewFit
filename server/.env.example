# 복사해서 .env 로 쓰고 값 채우기 (Supabase 프로젝트 > Settings > API 에서 확인)
PORT=4000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon 키 — 사용자 JWT와 함께 RLS 적용 클라이언트를 만드는 데 사용 (클라와 같은 값)
SUPABASE_ANON_KEY=
# service_role 키 — RLS 우회. 서버 전용, 절대 프론트/깃에 올리지 말 것. 사용처는 services/crewStats.js·feedback.js만
SUPABASE_SERVICE_ROLE_KEY=
# AI 코칭 (구현 단계에서 사용)
CLAUDE_API_KEY=
