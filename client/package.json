{
  "name": "crewfit-client",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "node --input-type=module -e \"import { build } from 'vite'; await build({ define: { 'import.meta.env.VITE_API_URL': JSON.stringify(process.env.VITE_API_URL || 'https://crewfit-akvt.onrender.com') } });\"",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\" \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.102.8",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
