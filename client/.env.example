# 복사해서 .env 로 쓰고 값 채우기 (Supabase 프로젝트 > Settings > API)
# Vite는 VITE_ 접두사 변수만 클라이언트에 노출함.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# 기본은 같은 주소의 /api. 개발은 Vite 프록시, Render는 Express가 함께 제공.
VITE_API_URL=
# 네이버 클라우드 Maps의 Client ID(ncpKeyId). Web Dynamic Map 및 웹 서비스 URL 등록 필요.
# Client Secret은 브라우저 환경변수에 넣지 않습니다.
VITE_NAVER_MAP_CLIENT_ID=
